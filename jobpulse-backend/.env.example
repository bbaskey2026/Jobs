# ==============================================================================
# JobPulse Backend Environment Configuration (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobpulse?schema=public"

# Redis Connection (Used for BullMQ and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_characters_long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_this_with_another_secure_random_string_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie & Session Configuration
COOKIE_SECRET=replace_with_cookie_signing_secret_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Storage Configuration (Local dev or S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads/resumes
STORAGE_MAX_FILE_SIZE_BYTES=5242880

# Email Delivery Configuration (smtp, resend, or console)
EMAIL_DRIVER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerts@jobpulse.in
EMAIL_FROM_NAME="JobPulse Alerts"

# NoAuth External Job Provider Configuration
# (Credentials to be provided by project owner; placeholder pending official doc)
NOAUTH_API_BASE_URL=https://api.noauth.example.com/v1
NOAUTH_API_KEY=
NOAUTH_API_TIMEOUT_MS=10000
NOAUTH_ENABLED=false

# Logging
LOG_LEVEL=info
