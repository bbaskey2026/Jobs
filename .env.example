# JobPulse Master Environment Configuration Template
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobpulse?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=jobpulse_secure_jwt_secret_min_32_characters_long
REFRESH_TOKEN_SECRET=jobpulse_secure_refresh_token_secret_min_32_chars
COOKIE_SECRET=jobpulse_cookie_signing_secret_min_32_chars
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads/resumes
EMAIL_DRIVER=console
NOAUTH_ENABLED=false
NOAUTH_API_BASE_URL=https://api.noauth.example.com/v1
NOAUTH_API_KEY=
