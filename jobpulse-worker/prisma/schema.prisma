// Prisma schema for JobPulse (Government & Private Jobs Platform)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  JOB_SEEKER
  RECRUITER
  MODERATOR
  ADMIN
}

enum JobSector {
  CENTRAL_GOVERNMENT
  STATE_GOVERNMENT
  UPSC_STATE_PSC
  SSC
  BANKING_INSURANCE
  RAILWAYS
  DEFENCE_PARAMILITARY
  PSU
  TEACHING_EDUCATION
  POLICE_SECURITY
  HEALTHCARE_PUBLIC
  PRIVATE_IT
  PRIVATE_FINANCE
  PRIVATE_ENGINEERING
  PRIVATE_HEALTHCARE
  PRIVATE_OTHER
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UPCOMING
  CLOSED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  TEMPORARY
}

enum AlertFrequency {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ApplicationStatus {
  OUTBOUND_CLICK
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

enum SyncStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum SalaryPeriod {
  MONTHLY
  YEARLY
  PAY_SCALE
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  passwordHash           String
  fullName               String
  role                   UserRole           @default(JOB_SEEKER)
  isEmailVerified        Boolean            @default(false)
  emailVerificationToken String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  profile                UserProfile?
  resumes                Resume[]
  bookmarks              JobBookmark[]
  savedSearches          SavedSearch[]
  jobAlerts              JobAlert[]
  notifications          Notification[]
  applications           ApplicationRecord[]
  reportedJobs           ReportedJob[]
  auditLogs              AuditLog[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber        String?
  state              String?
  city               String?
  currentEducation   String?
  experienceYears    Int?         @default(0)
  preferredSectors   String[]     @default([])
  preferredLocations String[]     @default([])
  skills             String[]     @default([])
  bio                String?
  resumeUrl          String?
  resumeFileName     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  educationRecords   EducationRecord[]
  experienceRecords  ExperienceRecord[]
}

model EducationRecord {
  id             String       @id @default(uuid())
  userProfileId  String
  profile        UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  degree         String
  institution    String
  fieldOfStudy   String?
  startYear      Int?
  endYear        Int?
  grade          String?
  createdAt      DateTime     @default(now())
}

model ExperienceRecord {
  id             String       @id @default(uuid())
  userProfileId  String
  profile        UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  title          String
  company        String
  location       String?
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean      @default(false)
  description    String?
  createdAt      DateTime     @default(now())
}

model Organization {
  id                         String             @id @default(uuid())
  name                       String
  slug                       String             @unique
  sector                     JobSector
  category                   String?
  description                String?
  websiteUrl                 String?
  officialNotificationDomain String?
  logoUrl                    String?
  verificationStatus         VerificationStatus @default(VERIFIED)
  headquartersState          String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  jobs                       Job[]

  @@index([slug])
  @@index([sector])
  @@index([verificationStatus])
}

model JobCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        Job[]

  @@index([slug])
}

model Job {
  id                      String          @id @default(uuid())
  externalId              String?
  deduplicationHash       String?         @unique
  title                   String
  slug                    String          @unique
  summary                 String
  fullDescription         String
  organizationId          String
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department              String?
  sector                  JobSector
  categoryId              String?
  category                JobCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employmentType          EmploymentType  @default(FULL_TIME)
  vacanciesCount          Int?
  state                   String
  city                    String?
  isAllIndia              Boolean         @default(false)
  remoteType              String?         @default("ON_SITE")
  qualificationSummary    String
  experienceMin           Int?            @default(0)
  experienceMax           Int?
  salaryMin               Int?
  salaryMax               Int?
  salaryPeriod            SalaryPeriod?   @default(MONTHLY)
  salaryCustomDisplay     String?
  publishDate             DateTime        @default(now())
  applicationStartDate    DateTime?
  applicationDeadline     DateTime?
  status                  JobStatus       @default(PUBLISHED)
  sourceProvider          String?         @default("MANUAL_ADMIN")
  officialNotificationUrl String?
  applicationUrl          String?
  eligibilityCriteria     String?
  selectionProcess        String?
  applicationFee          String?
  howToApply              String?
  isDemoData              Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  bookmarks               JobBookmark[]
  applications            ApplicationRecord[]
  reportedJobs            ReportedJob[]
  attachments             JobAttachment[]

  @@index([sector])
  @@index([status])
  @@index([state])
  @@index([applicationDeadline])
  @@index([publishDate])
  @@index([organizationId])
  @@index([categoryId])
}

model JobAttachment {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title         String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  createdAt     DateTime @default(now())
}

model JobBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
}

model SavedSearch {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  searchParams Json
  hasAlert     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model JobAlert {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  keywords        String?
  sector          JobSector?
  categorySlug    String?
  state           String?
  qualification   String?
  frequency       AlertFrequency @default(DAILY_DIGEST)
  channels        String[]       @default(["EMAIL", "IN_APP"])
  isActive        Boolean        @default(true)
  lastDeliveredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  deliveries      NotificationDelivery[]

  @@index([userId])
  @@index([isActive])
  @@index([frequency])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean  @default(false)
  type      String   @default("JOB_ALERT")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model NotificationDelivery {
  id          String    @id @default(uuid())
  alertId     String?
  alert       JobAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  userId      String
  channel     String
  status      String
  payload     Json?
  error       String?
  deliveredAt DateTime  @default(now())

  @@index([alertId])
  @@index([userId])
  @@index([status])
}

model ApplicationRecord {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status              ApplicationStatus @default(OUTBOUND_CLICK)
  isExternalLinkClick Boolean           @default(true)
  appliedDate         DateTime          @default(now())
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([jobId])
}

model Resume {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFileName String
  storedFileName   String
  fileSizeBytes    Int
  mimeType         String
  storagePath      String
  isPrimary        Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([userId])
}

model JobSource {
  id                   String     @id @default(uuid())
  name                 String
  code                 String     @unique
  sourceType           String
  baseUrl              String
  isEnabled            Boolean    @default(true)
  syncIntervalMinutes  Int        @default(60)
  lastRunStatus        SyncStatus @default(IDLE)
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  consecutiveFailures  Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  runs                 JobSourceRun[]
  externalRecords      ExternalJobRecord[]

  @@index([code])
}

model JobSourceRun {
  id                       String     @id @default(uuid())
  jobSourceId              String
  jobSource                JobSource  @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
  status                   SyncStatus @default(RUNNING)
  recordsFound             Int        @default(0)
  recordsIngested          Int        @default(0)
  recordsUpdated           Int        @default(0)
  recordsSkippedDuplicates Int        @default(0)
  errorMessage             String?
  startedAt                DateTime   @default(now())
  finishedAt               DateTime?

  @@index([jobSourceId])
  @@index([status])
}

model ExternalJobRecord {
  id           String    @id @default(uuid())
  jobSourceId  String
  jobSource    JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)
  externalId   String
  rawPayload   Json
  payloadHash  String
  mappedJobId  String?
  createdAt    DateTime  @default(now())

  @@unique([jobSourceId, externalId])
  @@index([payloadHash])
}

model ReportedJob {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([jobId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
